<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Boots the real API host in-process so PublicRegistrationRemovedTests can
         read the actual route table (EndpointDataSource), which is the only way
         to see minimal-API routes such as the ones MapIdentityApi would add. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <!-- Match the EF Core 9.x version used by Persistence/SqlServer. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.0" />
    <!-- Real transactions, which the in-memory provider silently ignores. Used
         only by the rollback tests. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.0" />
    <!-- Pinned above the version EF Core 9.0.0 asks for (2.1.10), which bundles a
         native SQLite carrying GHSA-2m69-gcr7-jv3q. The whole SQLitePCLRaw set
         ships in lockstep, so pinning the bundle moves lib.e_sqlite3 with it.
         Drop this once the EF Sqlite reference asks for 2.1.11 or later. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Domain\Domain.csproj" />
    <ProjectReference Include="..\..\Application\Application.csproj" />
    <ProjectReference Include="..\..\Persistence\Persistence.csproj" />
    <!-- Needed by PublicRegistrationRemovedTests, which asserts on the
         controllers' routing/authorization attributes. -->
    <ProjectReference Include="..\..\API\API.csproj" />
  </ItemGroup>

</Project>
